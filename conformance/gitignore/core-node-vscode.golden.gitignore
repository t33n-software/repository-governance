# canonical: gitignore core + node/core + node/vscode @ 0123456789abcdef0123456789abcdef01234567 — governed region, do not edit
# Local build and test outputs.
.build/
dist/
coverage/
.cache/

# Universal toolchain output suffix.
*.out

# Editor and operating-system state.
.DS_Store
.idea/

# Never-commit secret-artifact guard (the client-side projection of the
# server-side push boundary).
.env
.env.*
.envrc
.env*.local
credentials
credentials.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ppk
*.gpg

# node/core
# Node.js/TypeScript toolchain artifacts.
node_modules/
.pnpm/
.tsbuild/
*.tsbuildinfo
logs/
out/

# Auth-local registry credentials (never committed; the auth-local policy
# keeps them local or CI-generated).
.npmrc
auth.ini

# node/vscode
# VS Code extension delivery surfaces: .vscode-test/ is the download directory
# of the official @vscode/test-electron harness, where downloadAndUnzipVSCode
# stores each test instance under .vscode-test/vscode-<version>; *.vsix is the
# packaged extension artifact produced by @vscode/vsce.
.vscode-test/
*.vsix

# -- project additions below this line --
